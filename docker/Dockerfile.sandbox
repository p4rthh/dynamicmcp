FROM python:3.12-slim

# Install system dependencies for OpenShell sandboxing
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    iptables \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-install core runtime packages
RUN pip install --no-cache-dir \
    httpx>=0.27.0 \
    pydantic>=2.7.0 \
    fastmcp>=0.1.0 \
    mcp>=1.0.0

# Create restricted workspace
RUN mkdir -p /tmp/workspace && chmod 777 /tmp/workspace

ENV DYNAMICMCP_SANDBOX=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python3"]
